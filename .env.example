# Copie para .env e preencha. O .env real fica fora do versionamento.
# Obtenha a chave em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Opcional — fallback automático quando o Gemini esgota os retries (429/503).
# Obtenha em https://console.groq.com/keys
GROQ_API_KEY=

# Opcionais (valores padrão mostrados):
# LLM_PROVIDER=gemini          # ou "ollama" (local, offline)
# SCAN_LIMIT=50                # vagas analisadas pelo LLM por scan
# USE_EMBEDDING_RANK=true      # pré-ranqueia por similaridade ao perfil-alvo
# USE_LINKEDIN=true

# HOST=127.0.0.1              # padrão local; 0.0.0.0 permite acesso pela rede
# APP_USER=admin
# APP_PASSWORD_HASH=          # gere com: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('troque-esta-senha'))"
